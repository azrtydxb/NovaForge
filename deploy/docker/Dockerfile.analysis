# Runtime image for services that analyse repository contents: the gates
# service (the seven merge gates) and work-reviews (the maintenance scanners).
#
# These services run real tools against a materialised tree, so the image
# carries them: the Go toolchain (go test, go vet, go list, and go/packages in
# the architecture gate), gitleaks, osv-scanner and semgrep with a vendored
# ruleset. They once shelled out to a "procoder" binary that no image
# contained and whose JSON output did not exist, which made three scanners and
# most gates unable to run anywhere. Every download is pinned and checksummed.
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION} AS build
ARG SERVICE
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags "-s -w" \
      -o /out/app ./cmd/${SERVICE}

FROM golang:${GO_VERSION} AS tools
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
ARG OSV_VERSION=2.5.1
ARG OSV_SHA256=3d0f5aa5a6baa8eb32bcef247388e149ef6030a6634ccae6fa0d62681fb27a6d
RUN curl -sSfL -o /tmp/gitleaks.tgz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_arm64.tar.gz" \
 && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tgz" | sha256sum -c - \
 && tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks \
 && curl -sSfL -o /usr/local/bin/osv-scanner \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_arm64" \
 && echo "${OSV_SHA256}  /usr/local/bin/osv-scanner" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/gitleaks /usr/local/bin/osv-scanner

# The offline advisory snapshot the vulnerability scanner reads. The sandbox has
# no network at all (deny-all NetworkPolicy, GOPROXY=off), so osv-scanner cannot
# fetch its advisory database at scan time: the database is part of the image or
# the dependencies gate simply cannot run. internal/analysis expects it at the
# fixed path /opt/analysis/osv and verifies every ZIP against the digest in
# manifest.json before trusting it, so a truncated or swapped download makes the
# scan unavailable rather than silently clean.
#
# The four ecosystems here are exactly the manifest kinds the approval policy
# detects — go.mod, package.json, requirements*.txt and Cargo.toml. Adding an
# ecosystem to that list means adding it here too, or dependencies declared that
# way are scanned against no advisories.
#
# The snapshot carries an explicit validity interval, and an expired manifest
# makes the scan unavailable rather than clean. The image therefore has to be
# rebuilt inside ADVISORY_VALID_DAYS; that is deliberate, because a
# vulnerability scan against a year-old advisory database is worse than none.
FROM golang:${GO_VERSION} AS advisories
ARG ADVISORY_VALID_DAYS=90
RUN apt-get update \
 && apt-get install -y --no-install-recommends unzip \
 && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    root=/opt/analysis/osv; mkdir -p "$root/osv-scalibr"; \
    : >/tmp/ecosystems; \
    for eco in Go npm PyPI crates.io; do \
      mkdir -p "$root/osv-scalibr/$eco"; \
      curl -sSfL -o "$root/osv-scalibr/$eco/all.zip" \
        "https://osv-vulnerabilities.storage.googleapis.com/$eco/all.zip"; \
      # A ZIP that does not open is a failed download, not an empty ecosystem.
      unzip -tqq "$root/osv-scalibr/$eco/all.zip" >/dev/null; \
      printf '%s %s\n' "$eco" "$(sha256sum "$root/osv-scalibr/$eco/all.zip" | cut -d' ' -f1)" >>/tmp/ecosystems; \
    done; \
    # The reader requires exactly four fields, rejects duplicate keys, and wants
    # RFC 3339 times with generated_at <= now < valid_until.
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
    until_="$(date -u -d "+${ADVISORY_VALID_DAYS} days" +%Y-%m-%dT%H:%M:%SZ)"; \
    { printf '{"schema_version":1,"generated_at":"%s","valid_until":"%s","ecosystems":{' "$now" "$until_"; \
      sep=''; while read -r eco digest; do printf '%s"%s":"%s"' "$sep" "$eco" "$digest"; sep=','; done </tmp/ecosystems; \
      printf '}}\n'; } >"$root/manifest.json"; \
    rm -f /tmp/ecosystems

# The sandbox stage is the analysis toolchain with no service binary: it is
# published as its own image and is what the gates service runs repository code
# inside (NF_GATE_ANALYSIS_IMAGE). It is a stage of this file rather than a
# separate Dockerfile so the sandbox and the gates service cannot drift onto
# different tool versions — a gate that measured one semgrep here and another
# there would report findings nobody could reproduce.
FROM golang:${GO_VERSION} AS sandbox
ARG SEMGREP_VERSION=1.173.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates openssh-client python3 python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/semgrep \
 && /opt/semgrep/bin/pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" \
 && ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep
COPY --from=tools /usr/local/bin/gitleaks /usr/local/bin/osv-scanner /usr/local/bin/
COPY deploy/analysis/semgrep-gosec.yml /opt/analysis/semgrep-gosec.yml
# Read-only at runtime: the scanner checks every ancestor of these paths for
# symlinks and refuses the snapshot if any is one.
COPY --from=advisories /opt/analysis/osv /opt/analysis/osv
# The services run as a non-root user with a read-only view of nothing but
# their temp dirs; give the toolchain writable caches there.
ENV GOCACHE=/tmp/go-cache GOMODCACHE=/tmp/go-mod GOTOOLCHAIN=local \
    SEMGREP_SEND_METRICS=off XDG_CACHE_HOME=/tmp/cache
# The sandbox pod runs as uid 65532 with a read-only root filesystem and
# overrides the command, so the stage above needs no entrypoint and no user.

FROM sandbox
COPY --from=build /out/app /app
ENTRYPOINT ["/app"]
