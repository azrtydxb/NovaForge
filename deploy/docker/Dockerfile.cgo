# Runtime image for services that need cgo (Tree-sitter grammars link C).
# The runtime base is glibc to match the builder, not musl.
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION} AS build
ARG SERVICE
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -trimpath -o /out/app ./cmd/${SERVICE}

FROM gcr.io/distroless/base-debian12:nonroot
COPY --from=build /out/app /app
USER nonroot:nonroot
ENTRYPOINT ["/app"]
